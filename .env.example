# Telegram
BOT_TOKEN=123456:ABC...            # от @BotFather, НОВЫЙ бот, не EVENTS BOT
OWNER_CHAT_ID=123456789            # твой chat_id (бот сам подскажет на /start)

# База (Railway подставит сам, если добавить Postgres и сослаться ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://...

# Секретный кусок адреса вебхука, любая длинная случайная строка
WEBHOOK_SECRET=придумай-длинную-строку-без-пробелов

# ЮКасса: Интеграция → Ключи API
YK_SHOP_ID=
YK_SECRET_KEY=

# Яндекс Метрика (необязательно): /site и блок «Лендинг стретча» в итогах
METRIKA_TOKEN=                # OAuth-токен с правом metrika:read
METRIKA_COUNTER_ID=113929945
METRIKA_GOAL_ID=              # id цели form_submit: Метрика → Настройка → Цели

# Необязательное
SHOP_NAME=НИКА
DIGEST_HOUR=21          # сводка дня, по Москве
WEEKLY_HOUR=10          # итоги недели в понедельник
QUIET_FROM=23           # ночью без звука
QUIET_TO=8
ALERT_FAIL_STREAK=3     # тревога после N отказов подряд
ALERT_WINDOW_MIN=60     # ...если они уложились в столько минут
NOTIFY_TEST=true        # присылать тестовые платежи (в аналитику не идут)
CHECK_IP=true
